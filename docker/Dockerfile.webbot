FROM node:20-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg mkvtoolnix tzdata xvfb x11vnc novnc websockify procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY web-bot/package.json web-bot/package-lock.json ./
# npm ci: reproducible-ustanovka po lockfile (ranshe npm install tyagel
# noveyschie versii na kazhdom rebuild-e, i razvorovannyy tranzitivnyy
# paket popadal by v obraz, kotoryy kidaet zhivyye Zoom-vstrechi)
RUN npm ci && npx playwright install --with-deps chromium

COPY web-bot/src ./src
COPY templates ./templates

# VNC-sessii: odin postoyannyy ekran nastroyki (:99/:6080) + individual'nyye
# ekrany vstrech (:99+slot/:6080+slot) — vsrc/vnc_manager.js. Stek
# Xvfb/x11vnc/websockify podnimayet sam menedzher (setup-podnimaetsya pri
# starte, job-streki — pri zahode v vstrechu). reCAPTCHA (FT §12: reshaet
# tol'ko chelovek) prokhoditsya cherno individual'nyy ekran vstrechi.
# Vneshniye 8080+slot -> vnutrenniye 6080+slot (docker-compose).
ENV DISPLAY=:99
EXPOSE 6080-6100
CMD ["bash", "-lc", "node src/index.js"]
